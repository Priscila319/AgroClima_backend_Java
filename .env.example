# Configuração local da API Java. Copie para backend/java/.env e preencha os valores.
# Mantenha a API presa ao loopback no desenvolvimento direto.
PORT=8080
SERVER_ADDRESS=127.0.0.1
DATABASE_URL=jdbc:mysql://localhost:3306/agroclima
DATABASE_USER=agroclima
DATABASE_PASSWORD=
DATABASE_POOL_SIZE=12

# Gere valores aleatórios distintos (hex com pelo menos 32 bytes) para os dois segredos.
JWT_SECRET=
JWT_TTL_MINUTES=60
INITIAL_ADMIN_EMAIL=admin@agroclima.com
INITIAL_ADMIN_PASSWORD=
# Mesmo valor configurado em backend/python/.env (INTERNAL_API_KEY), com pelo menos 32 caracteres.
INTERNAL_API_KEY=
MAX_LOGIN_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15

# ThingSpeak: o backend Java consulta o canal diretamente e grava no MySQL.
# THINGSPEAK_READ_API_KEY é um segredo: somente no .env local, nunca em arquivo versionado.
THINGSPEAK_ENABLED=false
THINGSPEAK_CHANNEL_ID=3499301
THINGSPEAK_READ_API_KEY=
THINGSPEAK_URL=https://api.thingspeak.com
# Mapa oficial do canal: field1 = temperatura (°C), field2 = umidade (%). Qualquer outro valor é rejeitado.
THINGSPEAK_FIELD_MAP='{"temperature":"field1","humidity":"field2"}'
THINGSPEAK_POLL_INTERVAL_SECONDS=300
THINGSPEAK_INITIAL_DELAY_SECONDS=15
THINGSPEAK_RESULTS_LIMIT=500

# Origens exatas para chamadas diretas do navegador; sem wildcard.
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://localhost:5173,http://localhost:5500,http://localhost:8081,http://127.0.0.1,http://127.0.0.1:3000,http://127.0.0.1:5173,http://127.0.0.1:5500,http://127.0.0.1:8081
